{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipstrack",
  "main": "./worker.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_URL": "https://clipstrack.clipstrack.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 */3 * * *",
      "0 2 * * *"
    ]
  }
}