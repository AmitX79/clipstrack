// ClipsTrack — multi-platform content tracker (YouTube, Instagram, TikTok)
// Prisma schema. Tables are snake_case; fields are camelCase Prisma defaults.
//
// One User owns many Channels (one per platform+username). Each Channel owns
// its Videos (YouTube videos / TikTok videos / Instagram posts) and a time
// series of ChannelSnapshots. Each Video owns a time series of VideoSnapshots.
//
// Numbers are stored as full integers — never rounded to k/M — and view
// counters use BigInt because YouTube's lifetime view totals can exceed the
// 32-bit range (2.1B).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums -----------------------------------------------------------------

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}

// Follower-type label differs per platform (subscribers/followers) — we use
// `followers` everywhere for model simplicity and label it in the UI.

// ---- Users -----------------------------------------------------------------

// Per-user data isolation: a visitor can only ever query their own channels.
// No auth system yet — the client sends a per-visitor id (cookie) that we use
// as the User id.
model User {
  id        String    @id @default(cuid(2))
  // Daily-credit attribution for the hourly cron, which has no request IP:
  // the ip+ct_uid combo hash is captured at request time (add/edit/refresh)
  // and re-used by the cron so background syncs share the visitor's budget.
  comboHash String?
  // Last sign of activity (any page load / add / refresh / edit / remove).
  // The daily cleanup cron deletes visitors who have been still for
  // INACTIVE_DAYS (5) consecutive days.
  lastActive DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]

  @@index([lastActive])
  @@map("users")
}

// ---- Channels --------------------------------------------------------------

model Channel {
  id          String    @id @default(cuid(2))
  platform    Platform
  username    String // handle as tracked, e.g. "mrbeast" (no @)
  externalId  String // platform account id: YT channelId / IG pk / TT uid
  displayName String?
  avatarUrl   String?
  profileUrl  String
  lastSyncedAt DateTime?
  lastSyncError String? // message from the most recent failed sync; null = last sync ok

  // Video-window config (per channel): oldVideoCount = how many of the most
  // recent *existing* videos to backfill once; latestVideoCount = how many of
  // the newest uploads to keep tracking on every sync. `backfilled` flips true
  // after the one-time old-video backfill has run.
oldVideoCount    Int      @default(8)
  latestVideoCount Int      @default(8)
  backfilled       Boolean  @default(false)

  // Optional alert threshold (percent, fractional allowed): when set, videos
  // whose like-ratio (likes/views %) drops below this are flagged in the
  // channel card. NULL = no threshold check for this channel.
  minLikeRatio Float?

  createdAt        DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos    Video[]
  snapshots ChannelSnapshot[]

  @@unique([userId, platform, username])
  @@index([platform, username])
  @@index([userId])
  @@map("channels")
}

// ---- Videos / Posts ---------------------------------------------------------

// One row per video/post/reel/short on a channel. `externalId` is the
// platform-native id (YouTube videoId, Instagram media id, TikTok video id)
// and is required so upserts stay idempotent across hourly sync runs.
model Video {
  id           String   @id @default(cuid(2))
  externalId   String // platform-native video/post id
  title        String?
  url          String
  thumbnailUrl String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // true = captured during the one-time old-video backfill (renders under the
  // card's "Old" section); false = tracked going forward (card "Latest").
  isBackfill   Boolean  @default(false)

  channelId String
  channel   Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots VideoSnapshot[]

  @@unique([channelId, externalId])
  @@index([channelId, publishedAt])
  @@map("videos")
}

// ---- Snapshots --------------------------------------------------------------

// Channel-level stats, captured every hourly sync. One row per sync.
// followers = subscribers on YouTube. totalPosts = video/post count.
model ChannelSnapshot {
  id          String   @id @default(cuid(2))
  followers   Int
  following   Int?
  totalPosts  Int
  totalViews  BigInt? // lifetime channel views (YouTube); can exceed 32-bit
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, recordedAt])
  @@map("channel_snapshots")
}

// Per-video stats, captured every hourly sync. One row per video per sync.
// `views` is nullable: YouTube/TikTok always report plays, but Instagram has
// no public view metric for image/carousel posts (only reels), so those rows
// store NULL and the UI renders "—" instead of a misleading 0.
model VideoSnapshot {
  id         String   @id @default(cuid(2))
  views      BigInt?
  likes      Int
  comments   Int
  favorites  Int? // TikTok "favorites"; null elsewhere
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  videoId String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, recordedAt])
  @@map("video_snapshots")
}

// ---- Visitor user ID / admin grants ----------------------------------------

// One row per visitor (ct_uid). `code` is the short shareable User ID shown on
// /accounts (e.g. "CT-X7K9P2") so users can hand it to an admin. The admin
// "Grant credits" panel uses it to find the visitor: `dailyOverride` is the
// visitor's PERMANENT daily credit limit — it replaces the global daily limit
// for this visitor every day until an admin changes or clears it (it does NOT
// reset at midnight). `bonusCredits` is a one-time top-up pool that is only
// drained after the daily allowance is exhausted (so it does NOT renew each
// day). `comboHash` tracks the visitor's current identity so the admin panel
// can read their daily usage.
model UserCode {
  id           String   @id @default(cuid(2))
  code         String   @unique
  userId       String   @unique
  comboHash    String?
  dailyOverride Int?
  bonusCredits Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_codes")
}

// Admin grant/override audit trail. One row per credit change ever made
// (bonus top-up, or permanent daily limit set/cleared). Keep rows even after
// the visitor's records are purged by the inactivity cleanup — this history is
// the reference for "what was ever granted". Intentionally NOT a Prisma
// relation, so a user_codes delete never cascades the audit trail away.
model GrantHistory {
  id        String    @id @default(cuid(2))
  userId    String
  type      GrantType
  amount    Int // bonus: credits given; OVERRIDE: new limit, 0 = cleared
  grantedAt DateTime  @default(now())

  @@index([userId, grantedAt])
  @@index([grantedAt])
  @@map("grant_history")
}

enum GrantType {
  BONUS
  OVERRIDE
}

// Daily inactivity cleanup summary. One row per run with only counts — the
// requirement explicitly wants a summary, not per-user deletion history.
model CleanupLog {
  id              String   @id @default(cuid(2))
  runAt           DateTime @default(now())
  deletedUsers    Int      @default(0)
  deletedChannels Int      @default(0)

  @@index([runAt])
  @@map("cleanup_logs")
}

// ---- Daily credits ---------------------------------------------------------

// Per-IP+ct_uid daily credit accounting (anti-abuse rate limiting). One row
// per combo hash per IST day; each fetched video costs 1 credit. The date is
// the Asia/Kolkata YYYY-MM-DD string so midnight-IST resets are exact.
model CreditUsage {
  id          String   @id @default(cuid(2))
  comboHash   String // sha256(`${ip}|${ct_uid}`); cron reuses User.comboHash
  date        String // IST date, YYYY-MM-DD
  creditsUsed Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([comboHash, date])
  @@index([date])
  @@map("credit_usage")
}

// Simple key/value app settings (e.g. the daily per-IP credit limit, editable
// from /admin). Reading with a default on miss keeps values self-seeding.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("settings")
}

// Official YouTube Data API v3 quota units consumed per IST day (the free
// tier is 10,000 units/day). Entirely separate from the per-IP ScrapeCreators
// credits that limit Instagram/TikTok syncs — counted as we call the API and
// shown in /admin.
model YoutubeQuotaUsage {
  id        String   @id @default(cuid(2))
  date      String   @unique // IST date, YYYY-MM-DD
  unitsUsed Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("youtube_quota_usage")
}

// ScrapeCreators API keys, managed from /admin. `active` removes a key from
// rotation without deleting it; `quotaExhausted` is set when the key runs out
// of credits so the client rotates to the next one. Remaining credits can be
// refreshed from GET /v1/account/credit-balance and shown in the admin panel.
model ScrapeKey {
  id               String    @id @default(cuid(2))
  label            String
  key              String
  active           Boolean   @default(true)
  quotaExhausted   Boolean   @default(false)
  remainingCredits Int?
  lastCheckedAt    DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([key])
  @@map("scrape_keys")
}

// Official YouTube Data API v3 keys, managed from /admin. Each key carries its
// own 10,000 units/day free quota, so rotating across keys multiplies the
// effective daily capacity — the single global quota was the scaling ceiling.
// `unitsUsed` is the count for `quotaDate` (IST day) and is reset lazily when
// the day rolls over. `quotaExhausted` is set when a key reaches its daily
// limit (or the API returns a quota/permission error) so the client rotates to
// the next key; it clears on the next day (or when an admin re-enables it).
model YoutubeKey {
  id             String    @id @default(cuid(2))
  label          String
  key            String
  active         Boolean   @default(true)
  quotaExhausted Boolean   @default(false)
  unitsUsed      Int       @default(0)
  quotaDate      String? // IST date (YYYY-MM-DD) the unitsUsed counter belongs to
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([key])
  @@map("youtube_keys")
}